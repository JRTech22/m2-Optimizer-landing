# PayPal REST (live or sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Optional: previous HMAC secret while rotating (keeps old licenses valid)
PAYPAL_SECRET_PREVIOUS=
# Optional override (default https://api-m.paypal.com)
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Alias accepted for license HMAC if PAYPAL_SECRET is unset
# M2_LICENSE_SECRET=

# Firebase Admin (preferred for server writes)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
